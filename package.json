{
  "name": "clockify-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"PORT=3001 node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "start-pm2": "npm run build && pm2 startOrRestart ecosystem.config.cjs --only clockify --update-env",
    "test": "node --test server/test.js src/lib/*.test.ts",
    "format": "prettier --write src",
    "pm2:stop": "pm2 stop clockify",
    "pm2:logs": "pm2 logs clockify"
  },
  "dependencies": {
    "express": "^5.1.0",
    "formik": "^2.4.6",
    "lucide-react": "^0.468.0",
    "pm2": "^7.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx-populate": "^1.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
